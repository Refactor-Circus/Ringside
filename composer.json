{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "refactor-circus/ringside",
    "description": "Ring Master's per-repo plugin: a spec-driven Claude Code workflow for PHP packages, from ticket to spec to gated review rounds to PR to post-mortem, with shared standards from vendor.",
    "type": "composer-plugin",
    "keywords": [
        "refactor-circus",
        "ring-master",
        "ringside",
        "claude-code",
        "standards"
    ],
    "homepage": "https://github.com/Refactor-Circus/Ringside",
    "license": "MIT",
    "authors": [
        {
            "name": "Jay Fletcher",
            "email": "5743488+jayjfletcher@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "composer-plugin-api": "^2.0",
        "symfony/console": "^7.2|^8.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "require-dev": {
        "composer/composer": "^2.8",
        "laravel/pint": "^1.32.1",
        "pestphp/pest": "^5.3.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "RefactorCircus\\Ringside\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RefactorCircus\\Ringside\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ringside"
    ],
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:unit": [
            "vendor/bin/pest"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:unit"
        ]
    },
    "extra": {
        "class": "RefactorCircus\\Ringside\\Plugin",
        "plugin-optional": true
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
